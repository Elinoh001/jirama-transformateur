APP_NAME=Plateforme de gestion et de suivi préventif des transformateurs JIRAMA
DEBUG=true

# Remplace MON_MOT_DE_PASSE par ton mot de passe PostgreSQL.
# Si le mot de passe contient des caractères spéciaux (@ : / # %), il faut les encoder (ex: @ -> %40).
DATABASE_URL=postgresql://postgres:Postgres123@localhost:5432/jirama_db

# Clé secrète JWT (utilisée à l'étape 2). Change-la par une longue valeur aléatoire.
SECRET_KEY=change-me-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origines autorisées pour le frontend (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173